# --- Buna Corner — copy to .env.local (never commit real values) ---
# Telegram bot token from @BotFather
BOT_TOKEN=
# Bot username WITHOUT @, e.g. Alerter_nazbot
BOT_USERNAME=Alerter_nazbot
NEXT_PUBLIC_BOT_USERNAME=Alerter_nazbot
# Telegram user id of the shop owner (get it from @userinfobot)
OWNER_TELEGRAM_ID=
# Channel to post menu items to, e.g. @bunacorner or -1001234567890
CHANNEL_ID=
# Public URL of the deployed Mini App (Vercel URL)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Real DB (optional — demo runs in-memory; see prisma/schema.prisma)
DATABASE_URL="file:./dev.db"
# Gemini API key for Buna AI (chat + voice). PLACEHOLDER ONLY — never commit
# a real key. Without a key (or with TEST_KEY_1) the AI runs in mock mode:
# canned Amharic replies, no audio, no network calls. Get a key at
# https://aistudio.google.com/app/apikey and set it in Vercel env vars.
GEMINI_API_KEY=TEST_KEY_1
# In-chat payment uses Telegram Stars (XTR). Menu prices are ETB; this is how
# many ETB one Star is worth (rounded UP when converting). Default 2.5.
ETB_PER_STAR=2.5
